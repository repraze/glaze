{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "noEmit": false,
        "allowImportingTsExtensions": false,
        "rootDir": "src",
        "outDir": "dist",
        "declaration": true,
        "declarationMap": true,
        "sourceMap": true,
        "types": ["@webgpu/types"]
    },
    "include": ["src"],
    "exclude": ["src/**/*.test.ts"]
}
